# 3. Calculate average and median for each condition AND expertise level
agg_df <- df %>%
group_by(condition, expertise_level) %>%
summarise(
Average_Time_sec = mean(time_on_task_seconds, na.rm = TRUE),
Median_Time_sec = median(time_on_task_seconds, na.rm = TRUE),
.groups = 'drop' # Drops the grouping structure after summarising
)
# 4. Save aggregated data to a CSV
write.csv(agg_df, "time_on_task/aggregated_time_on_task_by_expertise.csv", row.names = FALSE)
# 5. Plotting: Bar charts for Mean and Median (Grouped)
# Make condition a factor for discrete axis plotting
agg_df$condition <- as.factor(agg_df$condition)
df$condition <- as.factor(df$condition)
# Mean Bar Chart (using position = "dodge" to place bars side-by-side)
p_mean <- ggplot(agg_df, aes(x = condition, y = Average_Time_sec, fill = expertise_level)) +
geom_bar(stat = "identity", position = "dodge") +
scale_fill_brewer(palette = "Blues") +
labs(title = "Average Time on Task by Condition and Expertise",
x = "Condition",
y = "Average Time (seconds)",
fill = "Expertise Level") +
theme_minimal()
# Median Bar Chart
p_median <- ggplot(agg_df, aes(x = condition, y = Median_Time_sec, fill = expertise_level)) +
geom_bar(stat = "identity", position = "dodge") +
scale_fill_brewer(palette = "Greens") +
labs(title = "Median Time on Task by Condition and Expertise",
x = "Condition",
y = "Median Time (seconds)",
fill = "Expertise Level") +
theme_minimal()
# Combine the two bar charts side-by-side using patchwork
combined_bars <- p_mean + p_median
print(combined_bars)
# Save the combined bar charts
ggsave("time_on_task/time_on_task_comparison_expertise.png", plot = combined_bars, width = 14, height = 5)
# 6. Plotting: Boxplot for full distribution comparison
p_box <- ggplot(df, aes(x = condition, y = time_on_task_seconds, fill = expertise_level)) +
geom_boxplot() +
scale_fill_brewer(palette = "Set2") +
labs(title = "Distribution of Time on Task by Condition and Expertise",
x = "Condition",
y = "Time on Task (seconds)",
fill = "Expertise Level") +
theme_minimal()
print(p_box)
# Save the boxplot
ggsave("time_on_task/time_on_task_distribution_expertise.png", plot = p_box, width = 8, height = 6)
# Print out the calculated aggregations
print(agg_df)
# 1. Read the dataset
df <- read.csv("UTA 21 Data - case_data.csv")
# 2. Convert the BI-RADS columns to factors with explicitly defined levels (1 to 5)
# This ensures our matrix will always be 5x5
df$birads_assistant <- factor(df$birads_assistant, levels = 1:5)
df$birads_radiologist <- factor(df$birads_radiologist, levels = 1:5)
View(df)
install.packages("caret")
library(caret)
# This will give you the matrix along with detailed statistical metrics
confusionMatrix(df$birads_assistant, df$birads_radiologist)
# This will give you the matrix along with detailed statistical metrics
confusionMatrix(df$birads_assistant, df$birads_radiologist)
conf_matrix <- table(Assistant = df$birads_assistant, Radiologist = df$birads_radiologist)
# 4. Print the result
print(conf_matrix)
