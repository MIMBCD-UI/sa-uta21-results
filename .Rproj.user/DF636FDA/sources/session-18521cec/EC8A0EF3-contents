# 1. Install necessary packages if you haven't already
# install.packages(c("lme4", "lmerTest", "lubridate", "dplyr"))

# 2. Load the libraries
library(lme4)
library(lmerTest)
library(lubridate)
library(dplyr)

# 3. Load your dataset
# Make sure your working directory is set to where the CSV is located
df <- read.csv("data/mimbcdui_uta21_case_data.csv")

# 4. Clean and prepare the data
df <- df %>%
  mutate(
    # Convert 'time_on_task' from string (e.g., "0:02:40") to total seconds
    time_on_task_sec = period_to_seconds(hms(time_on_task)),
    
    # Ensure categorical variables are treated as factors, not numbers/text
    expertise_level = as.factor(expertise_level),
    condition = as.factor(condition),
    participant_id = as.factor(participant_id)
  )

# 5. Build the Mixed-Effects Model
# Formula translation: 
# "Predict time_on_task_sec based on expertise_level AND condition, 
# while allowing each participant_id to have their own random baseline (intercept)."
model <- lmer(time_on_task_sec ~ expertise_level + condition + (1 | participant_id), data = df)

# 6. View the results
summary(model)