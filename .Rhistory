theme(legend.position = "none")
# Combine the two bar charts side-by-side using patchwork
combined_bars <- p_mean + p_median
print(combined_bars)
# Save the combined bar charts
ggsave("web/plots/time_on_task/time_on_task_comparison.png", plot = combined_bars, width = 12, height = 5)
# Plotting: Boxplot for full distribution comparison
p_box <- ggplot(df, aes(x = condition, y = time_on_task_seconds, fill = condition)) +
geom_boxplot() +
scale_fill_brewer(palette = "Set2") +
labs(title = "Distribution of Time on Task by Condition",
x = "Condition",
y = "Time on Task (seconds)") +
theme_minimal() +
theme(legend.position = "none")
print(p_box)
# Save the boxplot
ggsave("web/plots/time_on_task/time_on_task_distribution.png", plot = p_box, width = 8, height = 6)
# Print out the calculated aggregations
print(agg_df)
# ----------//----------
# Divide participants by experience
# Calculate average and median for each condition and expertise level
agg_df <- df %>%
group_by(condition, expertise_level) %>%
summarise(
Average_Time_sec = mean(time_on_task_seconds, na.rm = TRUE),
Median_Time_sec = median(time_on_task_seconds, na.rm = TRUE),
.groups = 'drop' # Drops the grouping structure after summarising
)
# Save aggregated data to a CSV
write.csv(agg_df, "web/plots/time_on_task/aggregated_time_on_task_by_expertise.csv", row.names = FALSE)
# Plotting: Bar charts for Mean and Median (Grouped)
# Make condition a factor for discrete axis plotting
agg_df$condition <- as.factor(agg_df$condition)
df$condition <- as.factor(df$condition)
# Mean Bar Chart (using position = "dodge" to place bars side-by-side)
p_mean <- ggplot(agg_df, aes(x = condition, y = Average_Time_sec, fill = expertise_level)) +
geom_bar(stat = "identity", position = "dodge") +
scale_fill_brewer(palette = "Blues") +
labs(title = "Average Time on Task by Condition and Expertise",
x = "Condition",
y = "Average Time (seconds)",
fill = "Expertise Level") +
theme_minimal()
# Median Bar Chart
p_median <- ggplot(agg_df, aes(x = condition, y = Median_Time_sec, fill = expertise_level)) +
geom_bar(stat = "identity", position = "dodge") +
scale_fill_brewer(palette = "Greens") +
labs(title = "Median Time on Task by Condition and Expertise",
x = "Condition",
y = "Median Time (seconds)",
fill = "Expertise") +
theme_minimal()
# Combine the two bar charts side-by-side using patchwork
combined_bars <- p_mean + p_median
print(combined_bars)
# Save the combined bar charts
ggsave("web/plots/time_on_task/time_on_task_comparison_expertise.png", plot = combined_bars, width = 14, height = 5)
# Plotting: Boxplot for full distribution comparison
p_box <- ggplot(df, aes(x = condition, y = time_on_task_seconds, fill = expertise_level)) +
geom_boxplot() +
scale_fill_brewer(palette = "Set2") +
labs(title = "Distribution of Time on Task by Condition and Expertise",
x = "Condition",
y = "Time on Task (seconds)",
fill = "Expertise") +
theme_minimal()
print(p_box)
# Save the boxplot
ggsave("web/plots/time_on_task/time_on_task_distribution_expertise.png", plot = p_box, width = 8, height = 6)
# Print out the calculated aggregations
print(agg_df)
# ----------//----------
# Paired-samples t-test to the same participant
library(dplyr)
library(tidyr)
# Assuming 'df' is your raw dataframe and 'time_on_task_seconds' exists
# Aggregate: Get average time per participant, per condition
participant_agg <- df %>%
group_by(participant_id, condition) %>%
summarise(mean_time = mean(time_on_task_seconds, na.rm = TRUE), .groups = 'drop')
# Pivot: Restructure data from long to wide
wide_df <- participant_agg %>%
pivot_wider(names_from = condition, values_from = mean_time) %>%
drop_na() # Drop missing pairs
# Run the Paired T-Test
# Note: R wraps numeric column names in backticks
test_result <- t.test(wide_df$`1`, wide_df$`2`, paired = TRUE)
print(test_result)
# Install required packages if you haven't already:
# install.packages(c("readr", "dplyr", "tidyr", "ggplot2", "stringr"))
library(readr)
library(dplyr)
library(tidyr)
library(ggplot2)
library(stringr)
# Read the CSV file, skipping the first row (which contains category groups)
df <- read_csv("data/mimbcdui_uta21_questionnaire_answers.csv", skip = 1)
# ---------------------------------------------------------
# SUS
# ---------------------------------------------------------
# Select the 10 SUS questions (columns 6 to 15)
sus_data <- df %>% select(6:15)
# ---------------------------------------------------------
# SUS Combined
# ---------------------------------------------------------
# Convert the data from wide to long format for ggplot2
sus_long <- sus_data %>%
pivot_longer(cols = everything(), names_to = "Question", values_to = "Score")
# Wrap long question text for better readability on the Y-axis
sus_long$Question <- str_wrap(sus_long$Question, width = 55)
# Lock in the question order
sus_long$Question <- factor(sus_long$Question, levels = rev(unique(sus_long$Question)))
# Create the boxplot
sus_combined <- ggplot(sus_long, aes(x = Score, y = Question, fill = Question)) +
geom_boxplot(show.legend = FALSE, alpha = 0.7, color = "darkgray") +
scale_x_continuous(breaks = 1:5) +
theme_minimal() +
labs(
title = "System Usability Scale (SUS) Responses Aggregated",
x = "Likert Scale Score",
y = NULL
) +
theme(
plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
axis.text.y = element_text(size = 9),
panel.grid.minor = element_blank()
)
ggsave("web/plots/questionnaire_answers/sus_boxplot_combined.png",
plot = sus_combined, width = 10, height = 7, dpi = 300)
# ---------------------------------------------------------
# SUS Separated by Expertise
# ---------------------------------------------------------
# Select the expertise_level column (col 4) and the 10 SUS questions (cols 6:15)
sus_data <- df %>% select(expertise_level, 6:15)
# Convert from wide to long format, keeping expertise_level as an ID variable
sus_long <- sus_data %>%
pivot_longer(
cols = -expertise_level,
names_to = "Question",
values_to = "Score"
)
# Wrap long question text for a cleaner Y-axis
sus_long$Question <- str_wrap(sus_long$Question, width = 50)
# Lock in the question order
sus_long$Question <- factor(sus_long$Question, levels = rev(unique(sus_long$Question)))
# Create the grouped boxplot
sus_separated_expertise <- ggplot(sus_long, aes(x = Score, y = Question, fill = expertise_level)) +
geom_boxplot(alpha = 0.8, color = "darkgray", position = position_dodge(0.8)) +
scale_x_continuous(breaks = 1:5) +
scale_fill_manual(values = c("novice" = "#66c2a5", "expert" = "#fc8d62")) + # Custom colors
theme_minimal() +
labs(
title = "System Usability Scale (SUS) Responses by Expertise Level",
x = "Likert Scale Score (1-5)",
y = NULL,
fill = "Expertise"
) +
theme(
plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
axis.text.y = element_text(size = 9),
panel.grid.minor = element_blank(),
legend.position = "right"
)
ggsave("web/plots/questionnaire_answers/sus_boxplot_separated_expertise.png",
plot = sus_separated_expertise, width = 10, height = 7, dpi = 300)
# ---------------------------------------------------------
# SUS Separated by Condition
# ---------------------------------------------------------
# Select the condition column (col 5) and the 10 SUS questions (cols 6:15)
sus_data <- df %>% select(condition, 6:15)
# Convert condition to a categorical factor so ggplot treats it as discrete groups
sus_data$condition <- factor(sus_data$condition, levels = c("2", "1"))
# Convert from wide to long format, keeping condition as an ID variable
sus_long <- sus_data %>%
pivot_longer(
cols = -condition,
names_to = "Question",
values_to = "Score"
)
# Wrap long question text for a cleaner Y-axis
sus_long$Question <- str_wrap(sus_long$Question, width = 50)
# Lock in the question order
sus_long$Question <- factor(sus_long$Question, levels = rev(unique(sus_long$Question)))
# Create the grouped boxplot
sus_separated_condition <- ggplot(sus_long, aes(x = Score, y = Question, fill = condition)) +
geom_boxplot(alpha = 0.8, color = "darkgray", position = position_dodge(0.8)) +
scale_x_continuous(breaks = 1:5) +
scale_fill_manual(values = c("1" = "#e41a1c", "2" = "#377eb8")) + # Custom colors for conditions
theme_minimal() +
labs(
title = "System Usability Scale (SUS) Responses by Condition",
x = "Likert Scale Score (1-5)",
y = NULL,
fill = "Condition"
) +
theme(
plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
axis.text.y = element_text(size = 9),
panel.grid.minor = element_blank(),
legend.position = "right"
)
ggsave("web/plots/questionnaire_answers/sus_boxplot_separated_condition.png",
plot = sus_separated_condition, width = 10, height = 7, dpi = 300)
# ---------------------------------------------------------
# SUS Separated by Expertise and Condition
# ---------------------------------------------------------
# Select the metadata columns and the 10 SUS questions
sus_data <- df %>% select(expertise_level, condition, 6:15)
# Convert condition to a categorical factor
sus_data$condition <- factor(sus_data$condition, levels = c("2", "1"))
# Capitalize expertise levels for nicer plot titles
sus_data$expertise_level <- str_to_title(sus_data$expertise_level)
# Convert from wide to long format
sus_long <- sus_data %>%
pivot_longer(
cols = -c(expertise_level, condition),
names_to = "Question",
values_to = "Score"
)
# Wrap the text so it fits
sus_long$Question <- str_wrap(sus_long$Question, width = 45)
# Lock in the factor order for the Question
sus_long$Question <- factor(sus_long$Question, levels = rev(unique(sus_long$Question)))
# Create the faceted boxplot
sus_separated_expertise_condition <- ggplot(sus_long, aes(x = Score, y = Question, fill = condition)) +
geom_boxplot(alpha = 0.8, color = "darkgray", position = position_dodge(0.8)) +
scale_x_continuous(breaks = 1:5) +
scale_fill_manual(values = c("1" = "#e41a1c", "2" = "#377eb8")) +
theme_minimal() +
labs(
title = "System Usability Scale (SUS) Responses by Expertise and Condition",
x = "Likert Scale Score (1-5)",
y = NULL,
fill = "Condition"
) +
theme(
plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
axis.text.y = element_text(size = 9),
panel.grid.minor = element_blank(),
strip.text = element_text(face = "bold", size = 12), # Formats the facet titles
legend.position = "right"
) +
# This splits the chart into two panels based on expertise
facet_wrap(~ expertise_level, ncol = 1)
ggsave("web/plots/questionnaire_answers/sus_boxplot_separated_expertise_condition.png",
plot = sus_separated_expertise_condition, width = 10, height = 14, dpi = 300)
